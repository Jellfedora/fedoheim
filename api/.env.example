# Serveur
PORT=3000
HOST=0.0.0.0
NODE_ENV=development
# DB_PATH / UPLOADS_DIR : par défaut "data.sqlite"/"uploads" (relatifs à ce dossier),
# à ne pas remplir ici en dev. En déploiement Docker, docker-compose.yml les pointe déjà
# vers le volume persistant ("/data/...") — inutile d'y toucher, voir README.

# Secret utilisé pour signer les JWT de session (générer une valeur aléatoire longue)
JWT_SECRET=change-me-to-a-long-random-string

# App OAuth2 Discord (Discord Developer Portal > OAuth2)
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
# Le "redirect_uri" (http://127.0.0.1:38217/callback) est un port fixe côté launcher,
# à enregistrer tel quel dans les "Redirect URIs" de l'app Discord — voir launcher/CLAUDE.md.

# Bot Discord séparé de l'app OAuth2, invité sur le serveur avec l'intent GUILD_MEMBERS
# pour pouvoir lire les rôles des joueurs
DISCORD_BOT_TOKEN=
DISCORD_GUILD_ID=
# ID du rôle Discord requis pour pouvoir utiliser le launcher
DISCORD_REQUIRED_ROLE_ID=
# ID du rôle Discord donnant les droits admin dans le launcher
DISCORD_ADMIN_ROLE_ID=

# Optionnels : sans eux, les annonces ne sont simplement pas repostées sur Discord.
# ID du salon Discord (verrouillé en écriture pour les joueurs, réactions autorisées)
# où poster les annonces. Le bot doit y avoir la permission "Envoyer des messages".
DISCORD_ANNOUNCEMENT_CHANNEL_ID=
# URL publique de cette API (pas 127.0.0.1) pour que Discord puisse intégrer les
# images d'annonces, ex: https://api.fedoheim.example.com
PUBLIC_API_URL=
# ID du salon Discord où afficher le règlement (édité en place à chaque modification
# depuis le launcher, pas reposté à chaque fois). Le bot doit y avoir la permission
# "Envoyer des messages" (et "Gérer les messages" pas nécessaire, juste éditer les siens).
DISCORD_RULES_CHANNEL_ID=
# ID du salon Discord où sont envoyés les LogOutput.log des joueurs (bouton "Envoyer
# log", à côté de "Réparer" dans le launcher). Le bot doit y avoir la permission
# "Envoyer des messages" + "Joindre des fichiers".
DISCORD_LOG_CHANNEL_ID=
