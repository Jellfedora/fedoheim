# OS
.DS_Store
Thumbs.db

# Editors
.vscode/*
!.vscode/extensions.json
.idea

# Node / build output (safety net — chaque sous-projet a aussi le sien)
node_modules/
dist/
dist-ssr/
*.log

# Exception : mods/dist/ contient les zips packagés des mods (dll + manifest +
# README/CHANGELOG), committés tels quels pour qu'un admin puisse les uploader
# directement depuis le repo sans avoir à rebuilder.
!mods/dist/
!mods/dist/**
mods/dist/.DS_Store

# Rust / Tauri (safety net — launcher/src-tauri a aussi le sien)
target/

# Secrets
.env
.env.local
