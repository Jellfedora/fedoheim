<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>netstandard2.1</TargetFramework>
    <AssemblyName>FedoServerTools</AssemblyName>
    <Nullable>disable</Nullable>
    <LangVersion>latest</LangVersion>
    <RestorePackages>false</RestorePackages>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <ValheimManagedDir>/Users/julienlecointe/Library/Application Support/Steam/steamapps/common/Valheim/valheim.app/Contents/Resources/Data/Managed</ValheimManagedDir>
    <ValheimBepInExCore>/Users/julienlecointe/Library/Application Support/Steam/steamapps/common/Valheim/BepInEx/core</ValheimBepInExCore>
    <ValheimPluginsDir>/Users/julienlecointe/Library/Application Support/Steam/steamapps/common/Valheim/BepInEx/plugins/FedoServerTools</ValheimPluginsDir>
    <ValheimSeasonsDll>/Users/julienlecointe/Library/Application Support/Steam/steamapps/common/Valheim/BepInEx/plugins/seasons/Seasons.dll</ValheimSeasonsDll>
  </PropertyGroup>

  <!-- UnityEngine.CoreModule fournit déjà PublicAPIAttribute/UsedImplicitlyAttribute
       (mêmes types que le package NuGet JetBrains.Annotations), pas besoin de l'ajouter :
       ça créerait un conflit de type (CS0433) avec ConfigSync.cs ci-dessous. -->
  <ItemGroup>
    <Compile Include="../_shared/ConfigSync.cs" Link="ConfigSync.cs" />
  </ItemGroup>

  <ItemGroup>
    <Reference Include="BepInEx">
      <HintPath>$(ValheimBepInExCore)/BepInEx.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="0Harmony">
      <HintPath>$(ValheimBepInExCore)/0Harmony.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine">
      <HintPath>$(ValheimManagedDir)/UnityEngine.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.CoreModule">
      <HintPath>$(ValheimManagedDir)/UnityEngine.CoreModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <!-- Input.GetKey (voir ClockOverlay.cs) : UnityEngine.dll ci-dessus n'en réexporte
         pas assez pour que le compilateur résolve UnityEngine.Input à partir de lui seul. -->
    <Reference Include="UnityEngine.InputLegacyModule">
      <HintPath>$(ValheimManagedDir)/UnityEngine.InputLegacyModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="assembly_valheim">
      <HintPath>$(ValheimManagedDir)/assembly_valheim.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <!-- IDistributionPlatform/ILocalUser/IUser/PlatformUserID (voir PeerSteamId.cs),
         pour résoudre le SteamID64 de l'hôte lui-même, qui n'a pas de ZNetPeer le
         représentant. -->
    <Reference Include="Splatform">
      <HintPath>$(ValheimManagedDir)/Splatform.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="assembly_utils">
      <HintPath>$(ValheimManagedDir)/assembly_utils.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.UI">
      <HintPath>$(ValheimManagedDir)/UnityEngine.UI.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <!-- Canvas/CanvasScaler/RenderMode (voir LoadingOverlay.cs), module core Unity,
         distinct de UnityEngine.UI.dll (uGUI : Text/Image/Button...) ci-dessus. -->
    <Reference Include="UnityEngine.UIModule">
      <HintPath>$(ValheimManagedDir)/UnityEngine.UIModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="Unity.TextMeshPro">
      <HintPath>$(ValheimManagedDir)/Unity.TextMeshPro.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <!-- Texture2D.LoadImage (extension method, voir LoadingLogo.cs), décodage PNG à la
         volée sans passer par le pipeline d'import de l'éditeur Unity. -->
    <Reference Include="UnityEngine.ImageConversionModule">
      <HintPath>$(ValheimManagedDir)/UnityEngine.ImageConversionModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <!-- Dépendance douce (voir SeasonReporting.cs) : jamais copiée (Private=false), le
         mod shudnal/Seasons doit être fourni par le modpack lui-même s'il est présent.
         Ce mod fonctionne sans lui (saison simplement non rapportée). -->
    <Reference Include="Seasons">
      <HintPath>$(ValheimSeasonsDll)</HintPath>
      <Private>false</Private>
    </Reference>
  </ItemGroup>

  <!-- Copie la DLL compilée, ainsi que le logo Fedoheim de l'écran de chargement (voir
       LoadingLogo.cs), dans le dossier plugins réel du jeu -->
  <Target Name="CopyToPlugins" AfterTargets="Build">
    <ItemGroup>
      <PluginOutputFiles Include="$(TargetDir)*.dll" />
      <PluginAssetFiles Include="fedoheim-logo.png" />
    </ItemGroup>
    <MakeDir Directories="$(ValheimPluginsDir)" Condition="!Exists('$(ValheimPluginsDir)')" />
    <Copy SourceFiles="@(PluginOutputFiles)" DestinationFolder="$(ValheimPluginsDir)" />
    <Copy SourceFiles="@(PluginAssetFiles)" DestinationFolder="$(ValheimPluginsDir)" />
  </Target>

</Project>
